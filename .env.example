# --- Security -------------------------------------------------------------
# Signing key for JWT session tokens. MUST be a long random value in production.
SECRET_KEY=dev-insecure-change-me

# --- LLM (optional) -------------------------------------------------------
# When ANTHROPIC_API_KEY is set the agent uses Claude for planning/synthesis.
# When unset, a deterministic rule-based planner is used instead, so the app,
# tests and demo all run with no external dependencies.
# ANTHROPIC_API_KEY=sk-ant-...
SOC_COPILOT_MODEL=claude-opus-4-8

# --- Session memory -------------------------------------------------------
# When REDIS_URL is set, conversation memory persists in Redis with a TTL.
# When unset, an in-process store is used (fine for a single instance / dev).
# REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30

# --- Server ---------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
